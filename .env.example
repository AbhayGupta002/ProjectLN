# ===================================================================
# WORLD_TOUR_APP - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ===================================================================
# Copy this file to .env and set secure production values.
# NEVER commit .env or production secrets into version control!

# Active Spring Profile (prod | dev)
SPRING_PROFILES_ACTIVE=prod

# Backend Server Port
PORT=8080

# Production MySQL Database Connection
DB_URL=jdbc:mysql://your-mysql-host:3306/worldtourdb?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Production MongoDB Connection (Chat Logs & Analytics)
MONGO_URI=mongodb+srv://your_user:your_pass@your-cluster.mongodb.net/worldtourdb?retryWrites=true&w=majority

# Security & JWT Authentication (Minimum 256-bit secure key)
JWT_SECRET=your_super_secret_256bit_key_do_not_commit
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origin (Frontend URL in production)
FRONTEND_URL=https://worldtours.com

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_smtp_app_password

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_live_secret

# Redis Cache (Optional / Production Session Store)
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# AI & LLM Provider Configuration (ollama | openai | gemini | mock)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
